# ==========================================
# ClipFlow AI - Backend Environment Config
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored on purpose.

# Service Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5435/clipflow?schema=public"

# Redis Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Session Security (JWT)
# Required in production — the server refuses to boot without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Optional — restricts the built-in admin dashboard to this email.
# Defaults to the original project owner's email if unset.
ADMIN_EMAIL=

# Google Gemini AI Config (Required for transcripts, highlights & scoring)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth 2.0 Credentials (Required for Google Auth & YouTube Publishing)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google-callback

# Stripe Billing & Subscriptions (Optional - falls back to Mock checkout if empty)
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP Email Server Config (Optional - falls back to mock console logs if empty)
# For Gmail, use an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ClipFlow Support <support@example.com>"

# AWS S3 / Cloudflare R2 Storage Config (Optional - falls back to local uploads/ directory if empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false
AWS_PUBLIC_URL_PREFIX=
