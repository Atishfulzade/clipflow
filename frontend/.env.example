# ==========================================
# ClipFlow AI - Frontend Environment Config
# ==========================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env / .env.local — they are gitignored on purpose.

# Backend API Endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google OAuth 2.0 Integration (Must match backend GOOGLE_CLIENT_ID and GOOGLE_REDIRECT_URI)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google-callback

# Stripe Integration (Must match backend STRIPE_PUBLISHABLE_KEY — publishable key only, never the secret key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
